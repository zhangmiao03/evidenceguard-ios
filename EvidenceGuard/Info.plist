<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>EvidenceGuard</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>EGServiceBaseURL</key>
	<string>$(EG_SERVICE_BASE_URL)</string>
	<key>EGSDKArtifactHash</key>
	<string>$(EG_SDK_ARTIFACT_HASH)</string>
	<key>EGSDKManagedAccount</key>
	<string>$(EG_SDK_MANAGED_ACCOUNT)</string>
	<key>EGSDKUserID</key>
	<string>$(EG_SDK_USER_ID)</string>
	<key>EGSDKAuthToken</key>
	<string>$(EG_SDK_AUTH_TOKEN)</string>
	<key>EGSDKEnvironment</key>
	<string>$(EG_SDK_ENVIRONMENT)</string>
	<key>EGInternalDemo</key>
	<string>$(EG_INTERNAL_DEMO)</string>
	<key>EGDemoAccessToken</key>
	<string>$(EG_DEMO_ACCESS_TOKEN)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>使用手机相机扫描摄像头设备二维码，识别需要添加的设备。</string>
	<key>NSContactsUsageDescription</key>
	<string>本测试版不提供通讯录功能，无需授权通讯录即可使用摄像头预览和守护；如出现访问请求，可以选择不允许。</string>
	<key>NSMotionUsageDescription</key>
	<string>本测试版不使用手机运动与健身数据，无需授权即可使用摄像头预览和守护；如出现访问请求，可以选择不允许。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>在添加摄像头时，用于发现附近的 Wi-Fi 网络并将摄像头连接到你选择的网络。</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>用于发现并连接你选择的蓝牙设备，包括摄像头、门铃、除草机和平板中枢。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>用于发现和连接局域网内的摄像头、门铃及团队测试服务。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>用于语音输入，以及在官方设备界面与摄像头或门铃进行双向对讲。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于在官方设备界面读取、保存直播截图和录像。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>用于将你手动拍摄的摄像头截图及录像保存到相册。</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>把你按住说话的内容转成可编辑文字，确认发送后才交给 AI。</string>
	<key>EGAPNSEnvironment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>预览未来 7 天的日历标题和日期。由你确认后才共享给 anker；不修改日历。</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>预览未完成提醒事项的标题和日期。由你确认后才共享给 anker；不修改提醒事项。</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>个人应用连接授权</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.zhangmiao.evidenceguard.connect</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
