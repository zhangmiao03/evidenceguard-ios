{
  "version": "0.3.0",
  "tools": [
    {
      "name": "devices_list",
      "description": "列出当前授权范围的设备，不推断实时在线状态",
      "capabilities": [
        "C01"
      ],
      "control": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      }
    },
    {
      "name": "device_inspect",
      "description": "读取登记能力、来源和未验证项",
      "capabilities": [
        "C02"
      ],
      "control": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "deviceId"
        ]
      }
    },
    {
      "name": "camera_observe",
      "description": "获取新直播帧，不移动设备",
      "capabilities": [
        "C07"
      ],
      "control": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "freshness": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          }
        },
        "required": [
          "deviceId"
        ]
      }
    },
    {
      "name": "camera_events_query",
      "description": "查询带来源的历史事件",
      "capabilities": [
        "C10"
      ],
      "control": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "from": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999999999
          },
          "to": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999999999
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "maxItems": 32
          }
        },
        "required": [
          "deviceId"
        ]
      }
    },
    {
      "name": "camera_ptz_step",
      "description": "默认方向单步；可显式申请 100–1100ms 有界连续动作并配对停止，不接受角度/轨迹",
      "capabilities": [
        "C16"
      ],
      "control": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "direction": {
            "type": "string",
            "enum": [
              "LEFT",
              "RIGHT",
              "UP",
              "DOWN"
            ]
          },
          "motionMode": {
            "type": "string",
            "enum": [
              "step",
              "continuous"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 1100
          },
          "referenceObservationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "expectedViewRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        },
        "required": [
          "deviceId",
          "direction",
          "referenceObservationId",
          "expectedViewRevision"
        ]
      }
    },
    {
      "name": "camera_goto_preset",
      "description": "跳转本设备真实预置位目录中的位置",
