# Copy to a private file and pass EG_ENV_FILE=/absolute/path/to/file.
# Never use VITE_* variables for model credentials.
EG_MODEL_BASE_URL=
EG_MODEL_ID=
EG_MODEL_API_KEY=
EG_MODEL_VISION=1
# When the chat model is text-only, set EG_MODEL_VISION=0 and configure a
# separate OpenAI-compatible image model for live-frame review:
# EG_VIDEO_BASE_URL=
# EG_VIDEO_MODEL_ID=
# EG_VIDEO_API_KEY=
EG_EMBED_MODEL_ID=
# Public single-team beta requires HTTPS, EG_REQUIRE_AUTH=1, and a random token.
# Never commit a real token or put one in the iOS bundle.
EG_REQUIRE_AUTH=0
EG_ACCESS_TOKEN=
# Empty registry + real devices imported by clients is the default.
# Use fixture only for explicit synthetic camera tests.
EG_CAMERA_MODE=official
# Optional: same-origin production Web build; run npm run build in Web first.
# EG_WEB_ROOT=/absolute/path/evidenceguard-ios/Web/dist
# Optional: where imported recordings and the database are stored.
# EG_DATABASE=/absolute/private/path/evidenceguard.sqlite3
# EG_VIDEO_ROOT=/absolute/private/path/recordings
# EVIDENCEGUARD_FIXTURE_URL=http://127.0.0.1:8787
# Optional: organizer Nova Pro key used only by the original Web Demo AI panel.
# Leave empty to keep its model proxy disabled; never put this key in Vite.
EG_OFFICIAL_AI_KEY=
