# Copy to a private file and pass EG_ENV_FILE=/absolute/path/to/file.
# Never use VITE_* variables for model credentials.
EG_MODEL_BASE_URL=
EG_MODEL_ID=doubao-seed-2-1-lite-260915
EG_MODEL_API_KEY=
# Optional official Codex App Server; only use the pinned, verified runtime.
# No OpenAI account/key is required: this uses the same Doubao Responses endpoint.
# Leave bounded-chat-v1 for local development without the Codex binary.
EG_AGENT_EXECUTOR=bounded-chat-v1
# EG_AGENT_EXECUTOR=codex-app-server-v1
# EG_CODEX_BINARY=/opt/evidenceguard-codex/0.162.1/codex
# EG_CODEX_RUNTIME_DIR=/var/lib/evidenceguard-demo/codex-runs
EG_MODEL_VISION=1
# All production capabilities use the Doubao family. Vision normally inherits chat.
# Optional separate Doubao image configuration for live-frame review:
# Omit each EG_VIDEO_* variable to inherit EG_MODEL_*; an empty value does NOT inherit.
# Historical read_stored_image has no automatic text-only fallback; use a vision chat model for it.
# EG_VIDEO_BASE_URL=
# EG_VIDEO_MODEL_ID=
# EG_VIDEO_API_KEY=
EG_EMBED_MODEL_ID=doubao-embedding-vision-251215
# Optional embedding endpoint/key; omitted values inherit EG_MODEL_BASE_URL/API_KEY.
# EG_EMBED_BASE_URL=
# EG_EMBED_API_KEY=
# Reindex recordings after changing the embedding model, instructions or sampling policy.
# Retrieval uses a model/version signature as well as the fixed 1024 dimensions.
# Public single-team beta requires HTTPS, EG_REQUIRE_AUTH=1, and a random token.
# Never commit a real token or put one in the iOS bundle.
EG_REQUIRE_AUTH=0
EG_ACCESS_TOKEN=
# Empty registry + real devices imported by clients is the default.
# Use fixture only for explicit synthetic camera tests.
EG_CAMERA_MODE=official
# Optional: same-origin production Web build; run npm run build in Web first.
# EG_WEB_ROOT=/absolute/path/evidenceguard-ios/Web/dist
# Optional: where imported recordings and the database are stored.
# EG_DATABASE=/absolute/private/path/evidenceguard.sqlite3
# EG_VIDEO_ROOT=/absolute/private/path/recordings
# EVIDENCEGUARD_FIXTURE_URL=http://127.0.0.1:8787
# Optional: organizer Nova Pro key used only by the original Web Demo AI panel.
# Leave empty to keep its model proxy disabled; never put this key in Vite.
EG_OFFICIAL_AI_KEY=
# APNs is off in local clones. Configure a separate scope and private key before enabling.
EG_APNS_ENABLED=0
# Optional native-app read-only connectors. Use a different key and credentials
# for each isolated service. Keep actual values in the private server env only.
EG_CONNECTOR_ORIGIN=
EG_CONNECTOR_ENCRYPTION_KEY=
EG_GMAIL_CLIENT_ID=
EG_GMAIL_CLIENT_SECRET=
EG_FEISHU_CLIENT_ID=
EG_FEISHU_CLIENT_SECRET=
EG_PUSH_SCOPE=local
# Normal use combines official events and foreground live relays.
# Set fixture_lab or EG_CAMERA_MODE=fixture only in an isolated test environment.
EG_CAMERA_SOURCE=official_sdk
# EG_APNS_TOPIC=com.zhangmiao.evidenceguard
# EG_APNS_TEAM_ID=
# EG_APNS_KEY_ID=
# EG_APNS_KEY_PATH=/absolute/private/path/AuthKey.p8
# EG_APNS_ENVIRONMENT=production
